# Copy to .env and fill in on your own laptop. Never commit .env. Testnet only.
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
DEPLOYER_PRIVATE_KEY=...        # fresh dev wallet (Deployer account), testnet only, never commit
BSCSCAN_API_KEY=...

# Used by contracts/script/Deploy.s.sol
HOSPITAL_ADDRESS=0x...            # demo hospital wallet (receives payments)
SOCIAL_WORKER_ADDRESS=0x...       # Approver account (Ma'am Liza), signs openCase and approveAndPay
VAULT_FUNDING_WEI=20000000000000000   # 0.02 tBNB

# Web app (web/ reads only these keys from this file; it never reads DEPLOYER_PRIVATE_KEY)
# Tulong (AI). Server-side only, never sent to the browser. Tried in this order; keys left as ... are skipped.
TULONG_PROVIDERS=gemini,groq,claude
GEMINI_API_KEY=...              # free tier, aistudio.google.com (main)
GEMINI_MODEL=gemini-3.6-flash  # optional
GROQ_API_KEY=...                  # free tier, console.groq.com (fallback)
GROQ_MODEL=openai/gpt-oss-120b    # optional
ANTHROPIC_API_KEY=...             # optional, paid; leave as ... to never use Claude
CLAUDE_MODEL=claude-opus-5-5      # optional
# Vault address + deploy block: read automatically from contracts/broadcast after `forge script --broadcast`.
# Set these only if the app runs somewhere without that file (e.g. Vercel):
VAULT_ADDRESS=0x...
VAULT_DEPLOY_BLOCK=...
HOSPITAL_LABEL=DOH Hospital · Batangas (demo)
# Optional: secret for the social worker's sign-in cookie. Any long random string.
# Without it, sign-ins reset every time the app restarts.
SESSION_SECRET=...
